#!/bin/bash

# Head: Preprocessed by build.sh

export PKG_CONFIG_LIBDIR="$DIR/prefix/$ARCH/lib/pkgconfig"
export PATH="$NDK_BIN_DIR:$PATH"

export CC="$CCACHE_PREFIX$NDK_TRIPLET$ANDROID_API-clang"
export CXX="$CCACHE_PREFIX$NDK_TRIPLET$ANDROID_API-clang++"
export AR="$NDK_BIN_DIR/llvm-ar"
export RANLIB="$NDK_BIN_DIR/llvm-ranlib"
export NM="$NDK_BIN_DIR/llvm-nm"
export STRIP="$NDK_BIN_DIR/llvm-strip"

export CFLAGS="$ENV_CFLAGS"
export CXXFLAGS="$ENV_CXXFLAGS"
export LDFLAGS="$ENV_LDFLAGS"
