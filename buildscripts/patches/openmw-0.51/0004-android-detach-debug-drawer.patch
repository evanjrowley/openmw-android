+#ifdef ANDROID
+    void RenderingManager::updateAndroidSunOcclusion(float dt)
+    {
+        // OPENMW_ANDROID_051_CPU_SUN_OCCLUSION
+        // Rate-limit the expensive scene-graph intersection to 20 Hz, then
+        // smooth the scalar each rendered frame. castRay() already excludes
+        // Sky/Effects/Water/Groundcover while retaining world blockers.
+        const float safeDt = std::max(0.f, dt);
+        mAndroidSunOcclusionRayTimer -= safeDt;
+
+        const auto& postProcessingChain = Settings::postProcessing().mChain.get();
+        const bool useAndroidSunOcclusion = Settings::postProcessing().mEnabled
+            && std::find(postProcessingChain.begin(), postProcessingChain.end(), "lensflare_android_051_rayocc")
+                != postProcessingChain.end();
+
+        if (useAndroidSunOcclusion && mAndroidSunOcclusionRayTimer <= 0.f
+            && mAndroidSunDiscDirection.length2() > 0.5f)
+        {
+            mAndroidSunOcclusionRayTimer = 0.05f;
+
+            const osg::Vec3d& cameraPos = mCamera->getPosition();
+            osg::Vec3f origin(static_cast<float>(cameraPos.x()), static_cast<float>(cameraPos.y()),
+                static_cast<float>(cameraPos.z()));
+            origin += mAndroidSunDiscDirection * 4.f;
+
+            const float rayDistance = std::max(mViewDistance, 1000.f);
+            const osg::Vec3f dest = origin + mAndroidSunDiscDirection * rayDistance;
+            const RayResult hit = castRay(origin, dest, true, false);
+
+            mAndroidSunOcclusionTarget = hit.mHit ? 0.f : 1.f;
+        }
+        else if (!useAndroidSunOcclusion)
+            mAndroidSunOcclusionTarget = 1.f;
+
+        const float responseSpeed = mAndroidSunOcclusionTarget < mAndroidSunOcclusion ? 18.f : 10.f;
+        const float response = std::min(1.f, safeDt * responseSpeed);
+        mAndroidSunOcclusion += (mAndroidSunOcclusionTarget - mAndroidSunOcclusion) * response;
+        mAndroidSunOcclusion = std::max(0.f, std::min(1.f, mAndroidSunOcclusion));
+        mPostProcessor->getStateUpdater()->setSunOcclusion(mAndroidSunOcclusion);
+    }
+#endif
