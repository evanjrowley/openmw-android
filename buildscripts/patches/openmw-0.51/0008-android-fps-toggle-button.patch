+        static const char* const keys[] = { "FrameRateToggleShow", "FrameRateLevel1", "FrameRateLevel2",
+            "FrameRateLevel3", "FrameRateLevel4" };
+        mFpsToggleButton->setCaptionWithReplacing(std::string("#{OMWEngine:") + keys[level] + "}");
+    }
